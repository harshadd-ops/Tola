# Tola: root environment reference. Each track also has its own .env.example.
# Never commit real secrets. Leave AI keys blank to run in cached mode.

# ---------- Web (Next.js, port 3000) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000      # FastAPI base URL
NEXT_PUBLIC_DEMO_MODE=true                     # true = role switcher + story mode, no login (demo track)

# ---------- API (FastAPI, port 8000) ----------
DATABASE_URL=sqlite:///./tola_demo.db          # demo; scalable: postgresql+psycopg://tola:tola@localhost:5432/tola
TOLA_SERVER_SIGNING_KEY=                       # base64 Ed25519 seed used to countersign server receipts
TOLA_UPI_VPA=tola-demo@upi                     # demo payee VPA (simulated, no money moves)
TOLA_UPI_PAYEE_NAME="Shetty Jewellers (Demo)"

# ---------- AI ----------
AI_FALLBACK_MODE=cached                        # live | cached | off  (cached = pre-recorded audio + template agents)
DEMO_RESET_TOKEN=                              # demo only: optional guard for POST /v1/demo/reset
LYZR_API_KEY=                                  # https://studio.lyzr.ai → Account → API Keys
LYZR_AGENT_ID_MANAGER=
LYZR_AGENT_ID_INTAKE=
LYZR_AGENT_ID_RECONCILE=
LYZR_AGENT_ID_SETTLE=
SARVAM_API_KEY=                                # https://dashboard.sarvam.ai (STT Saaras, TTS Bulbul)

# ---------- Scalable track only ----------
REDIS_URL=redis://localhost:6379/0
OTP_PROVIDER_KEY=                              # SMS OTP provider key
WHATSAPP_TOKEN=                                # Meta WhatsApp Cloud API token
WHATSAPP_PHONE_ID=
IVR_PROVIDER_KEY=                              # Exotel / Sarvam Voice Agents
PSP_KEY_ID=                                    # UPI payment service provider
PSP_KEY_SECRET=
GCS_BUCKET=tola-media-asia-south1              # audio + photos (India region)
OTEL_EXPORTER_OTLP_ENDPOINT=                   # OpenTelemetry collector
