# Tola demo build: environment variables
# Copy to implementation/demo/.env (docker-compose reads it) and to apps/web/.env.local (Next.js reads it).
# Names are fixed by docs/00-overview/PROJECT_BRIEF.md section 10. Do not rename.
# Never commit real keys. .env and .env.local are git-ignored.

# ---------- Web (apps/web, port 3000) ----------
# Base URL of the API as seen by the BROWSER. NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# 1 = show demo chrome: persona chips, story stepper, "Reset demo" and the SIMULATED labels. The demo build always runs with 1.
NEXT_PUBLIC_DEMO_MODE=1

# ---------- API (services/api, port 8000) ----------
# SQLite file. Relative paths resolve from services/api. POST /v1/demo/reset rebuilds it from seed/story.json.
DATABASE_URL=sqlite:///./tola-demo.db

# AI behaviour (see docs/BACKEND.md "AI clients and fallback"):
#   live   = call Lyzr / Sarvam; on error or timeout fall back to seed/ai-cache and seed/audio, then to templates
#   cached = never touch the network; replay seed/ai-cache + seed/audio (stage default, works offline)
#   off    = no AI at all; deterministic templates and seeded transcripts only
AI_FALLBACK_MODE=cached

# Lyzr Agent Studio (lyzr-adk 0.1.12). Create the four agents in Studio, paste their ids here.
LYZR_API_KEY=
LYZR_AGENT_ID_MANAGER=
LYZR_AGENT_ID_INTAKE=
LYZR_AGENT_ID_RECONCILE=
LYZR_AGENT_ID_SETTLE=

# Sarvam AI (sarvamai 0.1.37): Saaras STT (saaras:v3) and Bulbul TTS (bulbul:v3). The SDK also reads this name by default.
SARVAM_API_KEY=

# Server Ed25519 key: 64 hex chars (a 32-byte seed). Signs reconciliation runs, settlement drafts and chain checkpoints.
# Generate: python -c "import nacl.signing;print(nacl.signing.SigningKey.generate().encode().hex())"
# If empty, the API derives a fixed DEMO-ONLY key from the string "tola-demo:v1:server" and logs a warning.
TOLA_SERVER_SIGNING_KEY=

# UPI intent (SIMULATED in the demo: no money moves, no PSP is called). Payee shown in the QR.
TOLA_UPI_VPA=rafiq.demo@upi
TOLA_UPI_PAYEE_NAME=Rafiq Sheikh (demo)

# Optional: if set, POST /v1/demo/reset (API-02) requires header X-Demo-Reset-Token. Leave blank on a stage laptop.
DEMO_RESET_TOKEN=
