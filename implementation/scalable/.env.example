# =====================================================================
# Tola v1 (implementation/scalable) — environment variables
# Copy to .env (never commit it). In GCP these come from Secret Manager.
# Names are fixed by docs/00-overview/PROJECT_BRIEF.md §10. Variables
# marked [SCALABLE-EXTRA] are additions proposed by this track; they are
# listed in docs/ENVIRONMENT_SETUP.md and reported to the brief owner.
# =====================================================================

# ---------------------------------------------------------------------
# Web (apps/web) — NEXT_PUBLIC_* are baked into the client bundle. No secrets here.
# ---------------------------------------------------------------------
# Base URL of the API (port 8000 locally).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Always false in the scalable track (true only in implementation/demo).
NEXT_PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------------
# API + worker (services/api) — core
# ---------------------------------------------------------------------
# [SCALABLE-EXTRA] local | test | staging | prod. Controls log format, CORS, cookie flags.
TOLA_ENV=local
# Postgres 16. Async driver for the app; Alembic derives a sync URL from it.
DATABASE_URL=postgresql+asyncpg://tola:tola_local_only@localhost:5432/tola
# Redis 7: RQ queues, rate limits, OTP attempt counters, idempotency cache.
REDIS_URL=redis://localhost:6379/0
# [SCALABLE-EXTRA] Comma-separated allowed browser origins.
TOLA_CORS_ORIGINS=http://localhost:3000
# [SCALABLE-EXTRA] DEBUG | INFO | WARNING. Logs are JSON and PII-redacted in every env.
LOG_LEVEL=INFO
# [SCALABLE-EXTRA] rq | cloudtasks. Where the outbox relay dispatches jobs (BACKEND.md §6). GCP uses cloudtasks.
TOLA_JOB_BACKEND=rq

# ---------------------------------------------------------------------
# Crypto
# ---------------------------------------------------------------------
# Base64 Ed25519 32-byte seed. Server witness signature on every appended event (ARCHITECTURE §9.2).
# Generate: python -c "import nacl.signing,base64;print(base64.b64encode(bytes(nacl.signing.SigningKey.generate())).decode())"
TOLA_SERVER_SIGNING_KEY=
# [SCALABLE-EXTRA] 32+ random bytes (base64). Signs session JWTs (15 min access / 30 day refresh).
TOLA_SESSION_SECRET=
# [SCALABLE-EXTRA] 32+ random bytes (base64). HMAC key for pseudonymising phone numbers in logs/analytics.
TOLA_PII_HASH_KEY=
# [SCALABLE-EXTRA] Cloud KMS key holding the karigar's custodial key for WhatsApp/IVR confirmations (F-12;
# person_keys.key_label = custodial). Local: leave empty → a dev-only file key under .local/ is used, marked "dev".
TOLA_CUSTODIAL_KEY_KMS=

# ---------------------------------------------------------------------
# AI (M-01..M-03). AI never does gram arithmetic.
# ---------------------------------------------------------------------
# live | cached | off. Local default "cached" = no external AI calls, replay fixtures.
AI_FALLBACK_MODE=cached
LYZR_API_KEY=
LYZR_AGENT_ID_MANAGER=
LYZR_AGENT_ID_INTAKE=
LYZR_AGENT_ID_RECONCILE=
LYZR_AGENT_ID_SETTLE=
SARVAM_API_KEY=

# ---------------------------------------------------------------------
# Payments (F-07). Tola never holds money.
# ---------------------------------------------------------------------
# Default payee VPA / name used to build upi://pay intents when the shop has none on file.
TOLA_UPI_VPA=
TOLA_UPI_PAYEE_NAME=
# PSP (Razorpay / Cashfree / PhonePe PG — chosen per pilot) for intent/collect + status webhooks (API-20).
PSP_KEY_ID=
PSP_KEY_SECRET=
# [SCALABLE-EXTRA] Shared secret to verify PSP webhook signatures.
PSP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Auth (API-17): phone OTP
# ---------------------------------------------------------------------
# API key of the SMS/OTP provider (DLT-registered template required in India).
OTP_PROVIDER_KEY=
# [SCALABLE-EXTRA] console | sms. "console" prints the OTP to the API log (local/test ONLY; refused when TOLA_ENV=prod).
OTP_DELIVERY=console

# ---------------------------------------------------------------------
# Karigar channel (F-12, API-19)
# ---------------------------------------------------------------------
# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# [SCALABLE-EXTRA] App secret for X-Hub-Signature-256 verification of inbound webhooks.
WHATSAPP_APP_SECRET=
# [SCALABLE-EXTRA] Token echoed during the webhook GET verification handshake.
WHATSAPP_VERIFY_TOKEN=
# IVR (Exotel or Sarvam Voice Agents)
IVR_PROVIDER_KEY=

# ---------------------------------------------------------------------
# Storage + observability
# ---------------------------------------------------------------------
# Cloud Storage bucket (asia-south1) for scale photos and voice notes. Local: empty → ./.local/blobs
GCS_BUCKET=
# OTLP endpoint (traces/metrics). Empty → telemetry disabled locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
